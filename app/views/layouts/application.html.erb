<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "ERP SIG Financeiro" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="ERP SIG Financeiro">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="app-body">
    <% if user_signed_in? %>
      <nav class="navbar navbar-expand-lg bg-white border-bottom sticky-top">
        <div class="container-fluid">
          <%= link_to root_path, class: "navbar-brand fw-bold d-flex align-items-center gap-2" do %>
            <i class="bi bi-grid-1x2-fill text-primary"></i>
            ERP SIG
          <% end %>
          <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Abrir menu">
            <span class="navbar-toggler-icon"></span>
          </button>
          <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
              <li class="nav-item"><%= link_to "Dashboard", root_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "Lancamentos", financial_transactions_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "Contas", financial_accounts_path, class: "nav-link" %></li>
              <li class="nav-item"><%= link_to "Categorias", categories_path, class: "nav-link" %></li>
            </ul>
            <div class="d-flex align-items-center gap-3">
              <span class="small text-secondary d-none d-md-inline"><%= current_user.company.name %></span>
              <%= button_to destroy_user_session_path, method: :delete, class: "btn btn-outline-secondary btn-sm" do %>
                <i class="bi bi-box-arrow-right"></i>
              <% end %>
            </div>
          </div>
        </div>
      </nav>
    <% end %>

    <main class="container-fluid py-4">
      <% if notice.present? %>
        <div class="alert alert-success shadow-sm"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="alert alert-danger shadow-sm"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
