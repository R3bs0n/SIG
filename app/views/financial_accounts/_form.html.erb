<%= form_with model: account, class: "row g-3" do |f| %>
  <% if account.errors.any? %>
    <div class="col-12"><div class="alert alert-danger"><%= account.errors.full_messages.to_sentence %></div></div>
  <% end %>
  <div class="col-12 col-md-5">
    <%= f.label :name, "Nome", class: "form-label" %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>
  <div class="col-12 col-md-3">
    <%= f.label :account_type, "Tipo", class: "form-label" %>
    <%= f.select :account_type, FinancialAccount::ACCOUNT_TYPES.map { |type| [type.humanize, type] }, {}, class: "form-select" %>
  </div>
  <div class="col-12 col-md-3">
    <%= f.label :opening_balance, "Saldo inicial", class: "form-label" %>
    <%= f.number_field :opening_balance, step: "0.01", class: "form-control" %>
  </div>
  <div class="col-12 col-md-1 d-flex align-items-end">
    <div class="form-check">
      <%= f.check_box :active, class: "form-check-input" %>
      <%= f.label :active, "Ativa", class: "form-check-label" %>
    </div>
  </div>
  <div class="col-12 d-flex gap-2">
    <%= f.submit "Salvar", class: "btn btn-primary" %>
    <%= link_to "Cancelar", financial_accounts_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
