<% content_for :title, "Criar Conta" %>

<div class="row justify-content-center align-items-center min-vh-100">
  <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">
    <div class="auth-panel p-4 p-md-5">
      <div class="mb-4">
        <h1 class="h4 mb-1">Criar ambiente financeiro</h1>
        <p class="text-secondary mb-0">Informe seus dados e o nome da empresa.</p>
      </div>

      <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <div class="mb-3">
          <%= f.label :company_name, "Empresa", class: "form-label" %>
          <%= f.text_field :company_name, class: "form-control", required: true %>
        </div>
        <div class="mb-3">
          <%= f.label :name, "Nome", class: "form-label" %>
          <%= f.text_field :name, class: "form-control", required: true %>
        </div>
        <div class="mb-3">
          <%= f.label :email, "E-mail", class: "form-label" %>
          <%= f.email_field :email, autocomplete: "email", class: "form-control", required: true %>
        </div>
        <div class="mb-3">
          <%= f.label :password, "Senha", class: "form-label" %>
          <%= f.password_field :password, autocomplete: "new-password", class: "form-control", required: true %>
        </div>
        <div class="mb-4">
          <%= f.label :password_confirmation, "Confirmar senha", class: "form-label" %>
          <%= f.password_field :password_confirmation, autocomplete: "new-password", class: "form-control", required: true %>
        </div>
        <%= f.submit "Criar conta", class: "btn btn-primary w-100" %>
      <% end %>

      <div class="mt-4 small">
        <%= link_to "Ja tenho conta", new_session_path(resource_name) %>
      </div>
    </div>
  </div>
</div>
