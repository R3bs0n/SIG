<% content_for :title, "Entrar" %>

<div class="row justify-content-center align-items-center min-vh-100">
  <div class="col-12 col-sm-10 col-md-7 col-lg-5 col-xl-4">
    <div class="auth-panel p-4 p-md-5">
      <div class="mb-4">
        <div class="d-flex align-items-center gap-2 mb-2">
          <i class="bi bi-grid-1x2-fill text-primary fs-3"></i>
          <h1 class="h4 mb-0">ERP SIG Financeiro</h1>
        </div>
        <p class="text-secondary mb-0">Acesse sua gestao financeira empresarial.</p>
      </div>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        <div class="mb-3">
          <%= f.label :email, "E-mail", class: "form-label" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
        </div>
        <div class="mb-3">
          <%= f.label :password, "Senha", class: "form-label" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "form-control" %>
        </div>
        <% if devise_mapping.rememberable? %>
          <div class="form-check mb-4">
            <%= f.check_box :remember_me, class: "form-check-input" %>
            <%= f.label :remember_me, "Lembrar acesso", class: "form-check-label" %>
          </div>
        <% end %>
        <%= f.submit "Entrar", class: "btn btn-primary w-100" %>
      <% end %>

      <div class="mt-4 small">
        <%= link_to "Criar conta", new_registration_path(resource_name) %>
      </div>
    </div>
  </div>
</div>
