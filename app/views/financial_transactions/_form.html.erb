<%= form_with model: transaction, class: "row g-3" do |f| %>
  <% if transaction.errors.any? %>
    <div class="col-12">
      <div class="alert alert-danger"><%= transaction.errors.full_messages.to_sentence %></div>
    </div>
  <% end %>

  <div class="col-12 col-md-6">
    <%= f.label :description, "Descricao", class: "form-label" %>
    <%= f.text_field :description, class: "form-control", required: true %>
  </div>
  <div class="col-12 col-md-3">
    <%= f.label :kind, "Tipo", class: "form-label" %>
    <%= f.select :kind, [["Receita", "income"], ["Despesa", "expense"]], {}, class: "form-select" %>
  </div>
  <div class="col-12 col-md-3">
    <%= f.label :amount, "Valor", class: "form-label" %>
    <%= f.number_field :amount, step: "0.01", min: "0.01", class: "form-control", required: true %>
  </div>
  <div class="col-12 col-md-4">
    <%= f.label :financial_account_id, "Conta", class: "form-label" %>
    <%= f.collection_select :financial_account_id, @accounts, :id, :name, { prompt: "Selecione" }, class: "form-select", required: true %>
  </div>
  <div class="col-12 col-md-4">
    <%= f.label :category_id, "Categoria", class: "form-label" %>
    <%= f.collection_select :category_id, @categories, :id, :name, { prompt: "Selecione" }, class: "form-select", required: true %>
  </div>
  <div class="col-12 col-md-4">
    <%= f.label :status, "Status", class: "form-label" %>
    <%= f.select :status, [["Pendente", "pending"], ["Pago", "paid"], ["Atrasado", "overdue"], ["Cancelado", "canceled"]], {}, class: "form-select" %>
  </div>
  <div class="col-12 col-md-3">
    <%= f.label :due_date, "Vencimento", class: "form-label" %>
    <%= f.date_field :due_date, class: "form-control", required: true %>
  </div>
  <div class="col-12 col-md-3">
    <%= f.label :paid_at, "Pagamento", class: "form-label" %>
    <%= f.date_field :paid_at, class: "form-control" %>
  </div>
  <div class="col-12">
    <%= f.label :notes, "Observacoes", class: "form-label" %>
    <%= f.text_area :notes, rows: 3, class: "form-control" %>
  </div>
  <div class="col-12 d-flex gap-2">
    <%= f.submit "Salvar", class: "btn btn-primary" %>
    <%= link_to "Cancelar", financial_transactions_path, class: "btn btn-outline-secondary" %>
  </div>
<% end %>
