<% content_for :title, @transaction.description %>

<div class="panel p-3 p-md-4">
  <h1 class="h4 mb-3"><%= @transaction.description %></h1>
  <p><%= kind_badge(@transaction.kind) %> <%= status_badge(@transaction.status) %></p>
  <p class="fs-3 fw-bold"><%= money(@transaction.amount) %></p>
  <%= link_to "Voltar", financial_transactions_path, class: "btn btn-outline-secondary" %>
</div>
