<% content_for :title, "Categorias" %>

<div class="d-flex justify-content-between align-items-center gap-3 mb-4">
  <div>
    <h1 class="h3 mb-1">Categorias</h1>
    <p class="text-secondary mb-0">Classificacao das receitas e despesas.</p>
  </div>
  <%= link_to new_category_path, class: "btn btn-primary" do %>
    <i class="bi bi-plus-lg me-1"></i> Categoria
  <% end %>
</div>

<div class="panel p-3 p-md-4">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead>
        <tr>
          <th>Nome</th>
          <th>Tipo</th>
          <th>Cor</th>
          <th class="text-end"></th>
        </tr>
      </thead>
      <tbody>
        <% @categories.each do |category| %>
          <tr>
            <td class="fw-medium"><%= category.name %></td>
            <td><%= kind_badge(category.kind) %></td>
            <td><span class="badge" style="background-color: <%= category.color %>"><%= category.color %></span></td>
            <td class="text-end">
              <%= link_to edit_category_path(category), class: "btn btn-outline-secondary btn-sm btn-icon", title: "Editar" do %>
                <i class="bi bi-pencil"></i>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
